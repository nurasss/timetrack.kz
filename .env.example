# Copy to .env (gitignored) for server.js/server.vps.js to send email.
# Without this file, email sending is silently disabled.
#
# Two modes, picked automatically based on whether SMTP_USER/SMTP_PASS are set:
#
# 1) External provider over implicit TLS (AUTH LOGIN, port 465) — set USER+PASS:
SMTP_HOST=smtp.timetrack.kz
SMTP_PORT=465
SMTP_USER=no-reply@timetrack.kz
SMTP_PASS=
#
# 2) Local Postfix relay on the same host, trusted by source IP (no TLS, no
#    AUTH — only safe on a private network like the docker bridge gateway):
#    leave SMTP_USER/SMTP_PASS empty, point SMTP_HOST at the relay, and set
#    SMTP_FROM since there's no SMTP_USER to fall back to.
# SMTP_HOST=172.18.0.1
# SMTP_PORT=25
# SMTP_FROM=no-reply@timetrack.kz
